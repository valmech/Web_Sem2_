@model WebLab3.Models.Clients
@{ ViewData["Title"] = "Новий клієнт"; }
<h1>Новий клієнт</h1>
<form asp-action="Create" method="post">
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<label asp-for="LastName">Прізвище</label><input asp-for="LastName" class="form-control" />
	<label asp-for="FirstName">Ім'я</label><input asp-for="FirstName" class="form-control" />
	<label asp-for="MiddleName">По батькові</label><input asp-for="MiddleName" class="form-control" />
	<label asp-for="Phone">Телефон</label><input asp-for="Phone" class="form-control" />
	<label asp-for="ClientType">Тип клієнта</label><select asp-for="ClientType" class="form-control"><option>Покупець</option><option>Продавець</option></select>
	<button type="submit" class="btn btn-primary mt-3">Зберегти</button>
	<a asp-action="Index" class="btn btn-secondary mt-3">Скасувати</a>
</form>

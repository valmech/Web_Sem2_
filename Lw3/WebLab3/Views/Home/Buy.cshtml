@model IEnumerable<WebLab3.Models.Objects>

@{
    ViewData["Title"] = "Об'єкти нерухомості";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Список об'єктів нерухомості</h2>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Адреса</th>
            <th>Кількість кімнат</th>
            <th>Площа (м²)</th>
            <th>Ціна ($)</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Address</td>
                    <td>@item.Rooms</td>
                    <td>@item.Area</td>
                    <td>@item.Price.ToString("N0")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Записи відсутні</td>
            </tr>
        }
    </tbody>
</table>
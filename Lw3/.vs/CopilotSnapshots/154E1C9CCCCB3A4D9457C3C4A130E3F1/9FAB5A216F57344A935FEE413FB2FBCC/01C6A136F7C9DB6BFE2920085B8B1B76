@model IEnumerable<WebLab3.Models.RealEstate>

@{
    ViewData["Title"] = "Об'єкти нерухомості";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Список об'єктів нерухомості</h2>
    <a asp-action="Create" class="btn btn-primary">Додати новий об'єкт</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Адреса</th>
            <th>Кількість кімнат</th>
            <th>Площа (м²)</th>
            <th>Ціна ($)</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Address</td>
                    <td>@item.RoomsCount</td>
                    <td>@item.Area</td>
                    <td>@item.Price.ToString("N0")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редагувати</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Видалити</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Записи відсутні</td>
            </tr>
        }
    </tbody>
</table>